{
  "name": "block-develop-blog",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "dev": "node scripts/dev.mjs",
    "dev:site": "next dev --hostname 127.0.0.1 --port 3001",
    "build": "node scripts/check-content.mjs && next build",
    "preview": "node scripts/preview.mjs",
    "check": "node scripts/check-content.mjs",
    "test": "node --test tests/*.test.mjs",
    "format": "prettier --write app components lib scripts tests next.config.mjs package.json"
  },
  "dependencies": {
    "gray-matter": "^4.0.3",
    "highlight.js": "^11.11.1",
    "katex": "^0.16.25",
    "next": "^16.0.0",
    "react": "^19.2.0",
    "react-dom": "^19.2.0",
    "react-markdown": "^10.1.0",
    "rehype-highlight": "^7.0.2",
    "rehype-katex": "^7.0.1",
    "remark-gfm": "^4.0.1",
    "remark-math": "^6.0.0",
    "sharp": "^0.35.5"
  },
  "devDependencies": {
    "prettier": "^3.6.2"
  }
}
