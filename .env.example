# ============================================================
# article-agent — 環境變數範例
# 用法：cp .env.example .env，再填入自己的金鑰。
# .env 內含機密，務必加入 .gitignore，永不 commit。
# ============================================================

# ---------- 文字模型（文章改寫，OpenAI 相容 Responses API）----------
# 必填。改寫模型的 API key。
TEXT_API_KEY=your-text-api-key
# 供應商端點（OpenAI 相容）；留空則用官方預設。
TEXT_BASE_URL=https://claudex.org/v1
# 改寫用模型 ID。
TEXT_MODEL=deepseek-v4-flash

# ---------- 圖像模型（逐段生圖）----------
# 圖片供應商：evolink（Evolink 非同步任務 API）或 openai（OpenAI 相容同步 Images API）。
# 切換這一行即可；留空或 auto 會依 IMAGE_BASE_URL 網域自動判斷（evolink.ai → evolink）。
IMAGE_PROVIDER=evolink

# === 選項 A：Evolink 官方（非同步）===
IMAGE_API_KEY=your-image-api-key
IMAGE_BASE_URL=https://api.evolink.ai

# === 選項 B：OpenAI 相容中轉（同步，例：K站 https://kvkks.top/v1）===
# 要用時：IMAGE_PROVIDER=openai，並把上面選項 A 兩行註解、以下兩行取消註解。
#IMAGE_API_KEY=your-relay-key
#IMAGE_BASE_URL=https://kvkks.top/v1

# gpt-image-2.5-sunburst（偏重編輯精準）或 gpt-image-2.5-flare（較快）
IMAGE_MODEL=gpt-image-2.5-sunburst
# 可填比例（4:3、1:1、16:9…）或像素（1024x1024），預設 4:3
IMAGE_SIZE=4:3
# 1K / 2K / 4K（僅 Evolink 非同步 API 支援比例模式；OpenAI 相容 API 會忽略）
IMAGE_RESOLUTION=1K
# low / medium / high / xhigh / max
IMAGE_QUALITY=medium

# ---------- Evolink 任務輪詢（僅 IMAGE_PROVIDER=evolink 時使用）----------
# 兩次查詢任務狀態的間隔（毫秒）。
IMAGE_POLL_INTERVAL_MS=5000
# 單張圖等待上限（毫秒）；逾時會中止整次執行。
IMAGE_POLL_TIMEOUT_MS=600000

# 舊變數仍可作為後備：EVOLINK_API_KEY、EVOLINK_BASE_URL、
# OPENAI_API_KEY、OPENAI_BASE_URL、OPENAI_TEXT_MODEL、OPENAI_IMAGE_MODEL。
